# Normalize line endings so a clone behaves the same on every platform.
* text=auto

# Must be LF wherever they are checked out.
justfile      text eol=lf
Dockerfile    text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.toml        text eol=lf
*.py          text eol=lf
*.cff         text eol=lf
# With core.autocrlf=true, `text=auto` alone would check markdown out as CRLF.
*.md          text eol=lf

# Never touched.
*.pdf         binary
*.png         binary
*.jpg         binary
*.parquet     binary

# Left out of `git archive`, which makes the distributed copy: a local editor
# setup and the tools that check the author's own copies of the results.
.devcontainer/local                   export-ignore
scripts/compare_report_roots.py       export-ignore
scripts/rerun_report_steps.py         export-ignore
scripts/verify_archive_digests.py     export-ignore
tests/test_compare_report_roots.py    export-ignore
tests/test_rerun_report_steps.py      export-ignore
tests/test_verify_archive_digests.py  export-ignore

# Generated by tools that always write LF; pinned to LF so Windows checkouts do
# not rewrite them.
uv.lock       text eol=lf linguist-generated=true -diff
